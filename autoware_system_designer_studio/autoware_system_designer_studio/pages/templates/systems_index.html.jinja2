<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Autoware System Designer Studio</title>
    {% for scheme, href in icons.items() %}
    <link rel="icon" type="image/svg+xml" href="{{ href }}" media="(prefers-color-scheme: {{ scheme }})">
    {% endfor %}
    {% for href in stylesheets %}
    <link rel="stylesheet" href="{{ href }}">
    {% endfor %}
    {% for src in scripts %}
    <script src="{{ src }}"></script>
    {% endfor %}
    {% if systems %}
    <script>
        // The site opens on a system, showing only the studio mark meanwhile; the list
        // stays with ?list and when reached by Back or Forward.
        (function () {
            const navigation = performance.getEntriesByType('navigation')[0];
            if (new URLSearchParams(location.search).has('list')) return;
            if (navigation && navigation.type === 'back_forward') return;
            document.documentElement.classList.add('opening');
        })();
    </script>
    {% endif %}
</head>
<body class="simple-page index-page">
    <div class="page-container">
        <h1 class="brand-title">{% for theme, href in brand_icons.items() %}<img class="brand-icon theme-{{ theme }}-only" src="{{ href }}" alt="">{% endfor %}Autoware System Designer Studio</h1>
        {% if systems %}
        <ul class="system-list">
            {% for system in systems %}
            <li class="system-row">
                <a href="{{ system.page }}" class="system-entry" data-system="{{ system.id }}">
                    <img class="system-icon" src="{{ system.icon }}" alt="">
                    <span class="system-name">{{ system.name }}</span>
                    <span class="system-package">{{ system.package }}</span>
                </a>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <p class="empty-state">No exported systems found in the install tree.</p>
        {% endif %}
    </div>
    <script>
        SD.theme.init();
        // The opened system is the one shown last, else the first one.
        (function () {
            if (!document.documentElement.classList.contains('opening')) return;
            const entries = Array.from(document.querySelectorAll('.system-entry'));
            const last = SD.storage.get(SD.LAST_SYSTEM_KEY);
            const target = entries.find(function (entry) { return entry.dataset.system === last; }) || entries[0];
            setTimeout(function () { location.replace(target.href); }, 1000);
        })();
    </script>
</body>
</html>
