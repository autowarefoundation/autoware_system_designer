"""PATH entry point of the system runner; runs from <prefix>/bin without a sourced workspace."""

import os
import sys

# The unresolved script path keeps a symlink install anchored at its install prefix.
_PREFIX = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
_PYVER = f"python{sys.version_info.major}.{sys.version_info.minor}"
# Packages imported from here; an isolated install keeps each under its own sibling prefix.
_PACKAGE = "autoware_system_designer_runtime"
_DEPENDS: tuple = ()


def _prefixes():
    yield _PREFIX
    if os.path.basename(_PREFIX) == _PACKAGE:
        for depend in _DEPENDS:
            yield os.path.join(os.path.dirname(_PREFIX), depend)


def _import_paths(prefix):
    """Site directories of a prefix, and the source trees a symlink install links from them."""
    for site in (
        os.path.join(prefix, "lib", _PYVER, "site-packages"),
        os.path.join(prefix, "local", "lib", _PYVER, "dist-packages"),
    ):
        if not os.path.isdir(site):
            continue
        yield site
        for name in sorted(os.listdir(site)):
            if name.endswith(".egg-link"):
                with open(os.path.join(site, name), encoding="utf-8") as link:
                    target = link.readline().strip()
                if target:
                    yield target


for _prefix in _prefixes():
    for _path in _import_paths(_prefix):
        if os.path.isdir(_path) and _path not in sys.path:
            sys.path.insert(1, _path)

from autoware_system_designer_runtime.system_runner import main  # noqa: E402

if __name__ == "__main__":
    main()
