"""PATH entry point of the system runner; runs from <prefix>/bin without a sourced workspace."""

import os
import sys

# The unresolved script path keeps a symlink install anchored at its install prefix.
_PREFIX = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
_PYVER = f"python{sys.version_info.major}.{sys.version_info.minor}"
for _site in (
    os.path.join(_PREFIX, "lib", _PYVER, "site-packages"),
    os.path.join(_PREFIX, "local", "lib", _PYVER, "dist-packages"),
):
    if os.path.isdir(_site) and _site not in sys.path:
        sys.path.insert(1, _site)

from autoware_system_designer_runtime.system_runner import main  # noqa: E402

if __name__ == "__main__":
    main()
