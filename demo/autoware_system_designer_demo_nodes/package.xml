<?xml version="1.0"?>
<package format="3">
  <name>autoware_system_designer_demo_nodes</name>
  <version>0.40.0</version>
  <description>Dummy nodes of the example systems, generated from their node designs and exchanging std_msgs messages</description>

  <maintainer email="taekjin.lee@tier4.jp">Taekjin Lee</maintainer>
  <license>Apache License 2.0</license>
  <author email="taekjin.lee@tier4.jp">Taekjin Lee</author>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <buildtool_depend>autoware_cmake</buildtool_depend>

  <build_depend>python3-yaml</build_depend>

  <depend>autoware_system_designer</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
