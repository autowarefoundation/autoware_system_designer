<?xml version="1.0"?>
<launch>
  <!-- This launch file is auto-generated by the autoware_system_designer -->
  <!-- Border: {{ border_name }} / Components: {{ components | join(', ') }} -->

{% for argument in arguments %}
  <arg name="{{ argument.name }}"{% if argument.default is not none %} default="{{ argument.default }}"{% endif %}{% if argument.description %} description="{{ argument.description }}"{% endif %}/>
{% endfor %}

  <include file="$(dirname)/{{ unit_launcher }}">
{% for argument in arguments %}
    <arg name="{{ argument.name }}" value="$(var {{ argument.name }})"/>
{% endfor %}
  </include>
</launch>
