<?xml version="1.0"?>
<launch>
  <!-- This launch file is auto-generated by the autoware_system_designer from {{ source_file }} -->
{% if arguments %}

  <!-- Arguments -->
{% for argument in arguments %}
  <arg name="{{ argument.name }}"{% if argument.default is not none %} default="{{ argument.default }}"{% endif %}{% if argument.description %} description="{{ argument.description }}"{% endif %}/>
{% endfor %}
{% endif %}
{% if external_interfaces %}

  <!-- External interfaces -->
{% for interface in external_interfaces %}
  <arg name="{{ interface.name }}" default="{{ interface.topic }}"/>
{% endfor %}
{% endif %}
{% if system_launches %}

  <!-- System launches -->
{% for launch in system_launches %}
  <group{% if not launch.scoped %} scoped="false"{% endif %}>
    <include file="$(find-pkg-share {{ launch.package }})/{{ launch.file }}">
{% for name, value in launch.arguments %}
      <arg name="{{ name }}" value="{{ value }}"/>
{% endfor %}
    </include>
  </group>
{% endfor %}
{% endif %}

  <!-- Instance -->
{{ body | safe }}
</launch>
