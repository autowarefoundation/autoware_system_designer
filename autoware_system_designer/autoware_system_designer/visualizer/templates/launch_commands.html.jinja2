<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Launch — {{ system_name }}</title>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body class="simple-page">
    <div class="page-container">
        <div class="page-header">
            <h1>Launch Commands — {{ system_name }}</h1>
            <div class="dark-mode-toggle">
                <label for="dark-mode-switch">Dark Mode</label>
                <div class="toggle-switch" id="dark-mode-switch"></div>
            </div>
        </div>
        <div class="nav-links">
            <a href="{{ systems_index_path }}">← System index</a>
            <span class="nav-link-sep">|</span>
            <a href="{{ overview_path }}">Diagram</a>
        </div>
        <p class="page-description">Launch commands per mode and ECU (compute unit).</p>
        <div class="deploy-selector">
            <label for="method-select">Method:</label>
            <select id="method-select" aria-label="Select launch method">
                <option value="native"{% if not has_native %} disabled{% endif %}{% if default_method == 'native' %} selected{% endif %}>Runtime (autoware-system-designer-launch)</option>
                <option value="xml"{% if default_method == 'xml' %} selected{% endif %}>XML launcher (ros2 launch)</option>
            </select>
            <label for="deploy-select">Deploy:</label>
            {% if deploy_names %}
            <select id="deploy-select" aria-label="Select deploy">
                {% for name in deploy_names %}
                <option value="{{ name }}">{{ name }}</option>
                {% endfor %}
            </select>
            {% else %}
            <select id="deploy-select" disabled aria-label="Select deploy">
                <option>—</option>
            </select>
            {% endif %}
        </div>
        <p class="page-description method-note" id="method-note-xml"{% if default_method != 'xml' %} hidden{% endif %}>Runs the exported XML launcher through <code>ros2 launch</code>.</p>
        <p class="page-description method-note" id="method-note-native"{% if default_method != 'native' %} hidden{% endif %}>Runs the exported system structure under the designer runtime supervisor, one supervised process per node.{% if has_deploy_variants %} Deploy arguments are applied by the XML wrappers only, so every deploy shares the same runtime command.{% endif %}</p>
        {% if command_rows %}
        <table>
            <thead>
                <tr>
                    <th>Mode</th>
                    <th>ECU</th>
                    <th>Command</th>
                </tr>
            </thead>
            <tbody id="commands-tbody">
                {% for row in command_rows %}
                <tr>
                    {% if row.show_mode_cell %}
                    <td rowspan="{{ row.mode_rowspan }}">{{ row.mode }}</td>
                    {% endif %}
                    {% if row.show_ecu_cell %}
                    <td rowspan="{{ row.ecu_rowspan }}">{{ row.ecu }}</td>
                    {% endif %}
                    {% set cmd = row[default_method] %}
                    <td class="command-cell">
                        {% if cmd %}
                        <div class="command-with-copy">
                            <button type="button" class="copy-btn" data-cmd="{{ cmd | e }}">Copy</button>
                            <code>{{ cmd }}</code>
                        </div>
                        {% else %}
                        <span class="empty-state">—</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">No launch commands found for this deployment.</p>
        {% endif %}
    </div>
    <script src="theme.js"></script>
    <script>
        window.initializeTheme();
        document.getElementById('dark-mode-switch').addEventListener('click', function() {
            window.toggleDarkMode();
        });
        function bindCopyButtons(container) {
            if (!container) return;
            container.querySelectorAll('.copy-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var cmd = this.getAttribute('data-cmd');
                    if (!cmd) return;
                    navigator.clipboard.writeText(cmd).then(function() {
                        var label = btn.textContent;
                        btn.textContent = 'Copied!';
                        btn.classList.add('copied');
                        setTimeout(function() {
                            btn.textContent = label;
                            btn.classList.remove('copied');
                        }, 1500);
                    });
                });
            });
        }
        bindCopyButtons(document);
        (function() {
            var rowsByDeploy = {{ rows_by_deploy | tojson }};
            var tbody = document.getElementById('commands-tbody');
            var methodSelect = document.getElementById('method-select');
            var deploySelect = document.getElementById('deploy-select');
            if (!tbody) return;
            function escapeHtml(s) {
                var div = document.createElement('div');
                div.textContent = s;
                return div.innerHTML;
            }
            function rowHtml(row, method) {
                var modeCell = row.show_mode_cell
                    ? '<td rowspan="' + row.mode_rowspan + '">' + escapeHtml(row.mode) + '</td>'
                    : '';
                var ecuCell = row.show_ecu_cell
                    ? '<td rowspan="' + row.ecu_rowspan + '">' + escapeHtml(row.ecu) + '</td>'
                    : '';
                var cmd = row[method] || '';
                var body = cmd
                    ? '<div class="command-with-copy">' +
                      '<button type="button" class="copy-btn" data-cmd="' +
                      escapeHtml(cmd).replace(/"/g, '&quot;') + '">Copy</button>' +
                      '<code>' + escapeHtml(cmd) + '</code></div>'
                    : '<span class="empty-state">—</span>';
                return '<tr>' + modeCell + ecuCell + '<td class="command-cell">' + body + '</td></tr>';
            }
            function render() {
                var method = methodSelect.value;
                var deploy = deploySelect.disabled ? '' : deploySelect.value;
                var rows = rowsByDeploy[deploy] || [];
                tbody.innerHTML = rows.map(function(row) { return rowHtml(row, method); }).join('');
                bindCopyButtons(tbody);
                document.getElementById('method-note-xml').hidden = method !== 'xml';
                document.getElementById('method-note-native').hidden = method !== 'native';
            }
            methodSelect.addEventListener('change', render);
            deploySelect.addEventListener('change', render);
        })();
    </script>
</body>
</html>
